{
  "name": "vip-web-frontend",
  "version": "0.0.8",
  "description": "Variant Interpretation Pipeline web interface frontend",
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/molgenis/vip-web/issues"
  },
  "homepage": "https://github.com/molgenis/vip-web#readme",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molgenis/vip-web.git"
  },
  "scripts": {
    "build": "vite build",
    "build-dev": "vite build --mode dev",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "format": "prettier --write src/**/*.{json,tsx,ts}",
    "lint": "eslint src/**/*.{json,tsx,ts}",
    "prepare": "cd .. && husky vip-web-frontend/.husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.15.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.103.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@creativebulma/bulma-divider": "^1.1.0",
    "@creativebulma/bulma-tagsinput": "^1.0.3",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@solidjs/router": "^1.0.0",
    "axios": "^1.19.0",
    "bulma": "^0.9.4",
    "solid-js": "^1.9.15"
  },
  "lint-staged": {
    "src/**/*.{tsx,ts}": [
      "eslint",
      "prettier --write"
    ]
  },
  "engines": {
    "node": "24",
    "pnpm": "10"
  }
}
